{
  "name": "cookiesjs",
  "version": "4.0.2",
  "description": "Intuitive cookie manipulation library for the front-end",
  "repository": "github:franciscop/cookies",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "MIT",
  "keywords": [
    "cookies",
    "js",
    "javascript",
    "frontend",
    "expiration",
    "secure"
  ],
  "scripts": {
    "build": "bun run build:bundle && bun run build:types && npm run build:prettier",
    "build:bundle": "rolldown src/index.ts -f umd -n cookies -o index.min.js -m --exports default",
    "build:types": "dts-bundle-generator --out-file index.d.ts --project tsconfig.json src/index.ts",
    "build:prettier": "prettier --write src *.ts *.json",
    "lint": "oxlint src && tsc",
    "size": "echo $(gzip -c index.min.js | wc -c) bytes",
    "start": "bun test --watch",
    "test": "bun test"
  },
  "main": "index.min.js",
  "types": "index.d.ts",
  "files": [
    "index.min.js",
    "index.d.ts"
  ],
  "devDependencies": {
    "@endosome/dts-bundle-generator": "9.6.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.15",
    "typescript": "^7.0.2"
  }
}
